]

mode_tag = "\033[1;32m🎮 GAMING (TSO:Off)\033[0m" if mode == "gaming" else "\033[1;35m🎬 STREAMING (Retina HD)\033[0m"

def get_bytes(iface="en0"):
    try:
        out = subprocess.check_output(['netstat', '-ib', '-I', iface], stderr=subprocess.DEVNULL).decode()
        for line in out.strip().splitlines()[1:]:
            p = line.split()
            if len(p) >= 10 and (p[0] == iface or p[0] == f"<{iface}>" or p[0].startswith(iface)):
                return int(p[6]), int(p[9])
    except:
        pass
    return 0, 0

def get_battery():
    try:
        out = subprocess.check_output(['ioreg', '-rc', 'AppleARMPMUCharger'], stderr=subprocess.DEVNULL).decode()
        for line in out.splitlines():
            if 'CurrentCapacity' in line and '=' in line:
                return line.split('=')[1].strip() + "%"
    except:
        pass
    return "100%"

def ping(host, t=350):
    try:
        out = subprocess.check_output(['ping', '-c', '1', '-W', str(t), host], stderr=subprocess.DEVNULL).decode()
        for l in out.splitlines():
            if 'time=' in l:
                return float(l.split('time=')[1].split()[0])
    except:
        pass
    return None

def fmt(b):
    if b >= 1048576: return f"{b/1048576:.1f} MB/s"
    if b >= 1024: return f"{b/1024:.1f} KB/s"
    return f"{b} B/s"

def col_ping(ms):
    if ms is None: return f"{C_RED}Timeout{C_RESET}"
    if ms < 4.0: return f"{C_GREEN}{ms:.1f}ms{C_RESET}"
    if ms < 15.0: return f"{C_YELLOW}{ms:.1f}ms{C_RESET}"
    return f"{C_RED}{ms:.1f}ms{C_RESET}"

def check_stremio_clients():
    try:
        out = subprocess.check_output(['netstat', '-an'], stderr=subprocess.DEVNULL).decode()
        return sum(1 for l in out.splitlines() if '11470' in l and 'ESTABLISHED' in l)
    except:
        return 0

def find_active_apps():
    active = []
    try:
        out = subprocess.check_output(['/bin/ps', '-A', '-o', 'pid,command'], stderr=subprocess.DEVNULL).decode()
        for line in out.splitlines():
            for t in targets:
                if t.lower() in line.lower() and not any(x in line.lower() for x in ['grep', 'awk', 'shield']):
                    if t not in active:
                        active.append(t)
                        pid = line.split()[0]
                        subprocess.call(['sudo', 'renice', '-20', '-p', pid], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except:
        pass
    return active

def check_and_relock_arp(router_ip, auth_mac):
    if not auth_mac or auth_mac == "auto": return True
    try:
        out = subprocess.check_output(['arp', '-n', router_ip], stderr=subprocess.DEVNULL).decode()
        cur_mac = ""
        parts = out.split()
        if 'at' in parts:
            idx = parts.index('at')
            if idx + 1 < len(parts):
                raw = parts[idx + 1]
                cur_mac = ":".join(f"{int(x, 16):02x}" for x in raw.split(":"))
        if cur_mac != auth_mac or "permanent" not in out:
            subprocess.call(['sudo', 'arp', '-d', router_ip, 'ifscope', 'en0'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.call(['sudo', 'arp', '-s', router_ip, auth_mac, 'ifscope', 'en0'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return False
    except:
        pass
    return True

prev_ib, prev_ob = get_bytes()
prev_t = time.time()
loop = 0
r_ms, i_ms = None, None
bat_str = get_battery()
spoof_blocks = 0

print(f"\n{C_CYAN}🛡️   Anti-Lag Shield Pro v3.7 (Universal Network Sentinel)   🛡️{C_RESET}")
print(f"{C_GREEN}[✔] Auto-Detected Gateway: {router_ip} ({router_mac}) [Permanently Locked]{C_RESET}")
print(f"{C_GREEN}[✔] Bandwidth Thief Shield & Battery Saver: ACTIVE{C_RESET}\n")

try:
    while True:
        time.sleep(1.0)
        now_t = time.time()
        loop += 1
        cur_ib, cur_ob = get_bytes()
        dt = now_t - prev_t
        rx = int((cur_ib - prev_ib) / dt) if dt > 0 and cur_ib >= prev_ib else 0
        tx = int((cur_ob - prev_ob) / dt) if dt > 0 and cur_ob >= prev_ob else 0
        prev_ib, prev_ob, prev_t = cur_ib, cur_ob, now_t

        if loop % 2 == 0 or r_ms is None:
            r_ms = ping(router_ip, 350)
            i_ms = ping("1.1.1.1", 400)
            
        if loop % 3 == 0:
            if not check_and_relock_arp(router_ip, router_mac):
                spoof_blocks += 1

        if loop % 15 == 0:
            bat_str = get_battery()

        active = find_active_apps()
        stremio_streams = check_stremio_clients()

        ts = time.strftime('%H:%M:%S')
        r_str = col_ping(r_ms)
        i_str = col_ping(i_ms)
        down = f"{C_CYAN}↓ {fmt(rx)}{C_RESET}"
        up = f"{C_MAGENTA}↑ {fmt(tx)}{C_RESET}"

        if active:
            stremio_tag = f" [Serving Stream]" if stremio_streams > 0 else ""
            app_str = f"{C_BRIGHT_GREEN}🚀 {' + '.join(active[:2])}{stremio_tag} (VIP -20){C_RESET}"
        else:
            app_str = f"{C_GRAY}Sentinel Active{C_RESET}"

        sentinel_tag = f"{C_YELLOW}🛡️ Spoof Blocked ({spoof_blocks}x){C_RESET}" if spoof_blocks > 0 else f"{C_GREEN}🛡️ Gateway Guarded{C_RESET}"

        print(f"[{ts}] {mode_tag} | 📶 Wi-Fi (en0) | Router: {r_str} | Ping: {i_str} | 🔋 {bat_str} | {down} | {up} | {app_str} | {sentinel_tag}")
        sys.stdout.flush()
except KeyboardInterrupt:
    pass
