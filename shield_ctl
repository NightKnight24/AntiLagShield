#!/bin/sh
# ==============================================================================
# 🛡️ Anti-Lag Shield Pro v3.8 Controller (Universal iOS & iPadOS 11 - 18 Edition)
# Supports ALL 64-bit iOS & iPadOS Devices (Device Revival & Network Sentinel)
# ==============================================================================

# Universal shell bootstrap
if [ -z "$BASH_VERSION" ]; then
    for b in /var/jb/usr/bin/bash /usr/bin/bash /bin/bash /var/jb/bin/bash; do
        if [ -x "$b" ]; then exec "$b" "$0" "$@"; fi
    done
fi

if [ -d "/var/jb" ]; then
    JB="/var/jb"
else
    JB=""
fi

export PATH="${JB}/usr/bin:${JB}/bin:${JB}/usr/sbin:${JB}/sbin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

CONF_FILE="/var/mobile/Library/Preferences/com.jordan.antilagshield.conf"
STATE_FILE="/var/mobile/Library/Caches/shield_state.txt"
PID_FILE="/var/mobile/Library/Caches/shield_watchdog.pid"
DAEMON_PLIST="${JB}/Library/LaunchDaemons/com.jordan.antilagshield.plist"

ACTION="$1"
MODE="${2:-streaming}"
APP_PID="$3"

INTERFACE="en0"

init_config() {
    if [ ! -f "$CONF_FILE" ]; then
        mkdir -p "$(dirname "$CONF_FILE")" 2>/dev/null
        cat <<EOF > "$CONF_FILE"
GATEWAY_IP=auto
GATEWAY_MAC=auto
BANDWIDTH_SENTINEL=enabled
BATTERY_SAVER=enabled
GITHUB_URL=https://github.com/NightKnight24
EOF
        chmod 644 "$CONF_FILE" 2>/dev/null
    elif ! grep -q "^GITHUB_URL=" "$CONF_FILE" 2>/dev/null; then
        echo "GITHUB_URL=https://github.com/NightKnight24" >> "$CONF_FILE"
    fi
}

norm_mac() {
    local IFS=:
    local parts=($1)
    local out=""
    for p in "${parts[@]}"; do
        [ ${#p} -eq 1 ] && p="0$p"
        out="${out}${out:+:}$p"
    done
    echo "$out"
}

resolve_gateway() {
    init_config
    local cfg_ip=$(grep "^GATEWAY_IP=" "$CONF_FILE" 2>/dev/null | cut -d= -f2 | tr -d '[:space:]')
    local cfg_mac=$(grep "^GATEWAY_MAC=" "$CONF_FILE" 2>/dev/null | cut -d= -f2 | tr -d '[:space:]')

    # Detect Gateway IP
    if [ -z "$cfg_ip" ] || [ "$cfg_ip" = "auto" ]; then
        ROUTER_IP=$(route -n get default 2>/dev/null | awk '/gateway:/ {print $2}')
        [ -z "$ROUTER_IP" ] && ROUTER_IP="192.168.0.1"
    else
        ROUTER_IP="$cfg_ip"
    fi

    # Detect Gateway MAC
    if [ -z "$cfg_mac" ] || [ "$cfg_mac" = "auto" ]; then
        ping -c 1 -W 300 "$ROUTER_IP" >/dev/null 2>&1
        local raw_mac=$(arp -n "$ROUTER_IP" 2>/dev/null | awk '/at/ {for(i=1;i<=NF;i++) if($i=="at") print $(i+1)}')
        if [ -n "$raw_mac" ]; then
            ROUTER_MAC=$(norm_mac "$raw_mac")
        else
            ROUTER_MAC=""
        fi
    else
        ROUTER_MAC=$(norm_mac "$cfg_mac")
    fi
}

# Apple Background Telemetry & Battery-Draining Daemons (Safely queried across all iOS versions)
BATTERY_HOG_DAEMONS=(
    "com.apple.tipsd"
    "com.apple.tailspind"
    "com.apple.spindump"
    "com.apple.triald"
    "com.apple.ap.adprivacyd"
    "com.apple.parsec-fbf"
    "com.apple.siriinferenced"
    "com.apple.duetexpertd"
    "com.apple.coreduetd"
    "com.apple.photoanalysisd"
    "com.apple.mediaanalysisd"
    "com.apple.cloudphotod"
)

apply_battery_saver() {
    for d in "${BATTERY_HOG_DAEMONS[@]}"; do
        local plist="/System/Library/LaunchDaemons/$d.plist"
        if [ -f "$plist" ]; then
            sudo launchctl unload "$plist" >/dev/null 2>&1
        fi
    done
    sudo sysctl -w kern.timer.coalescing_enabled=1 >/dev/null 2>&1
}

revert_battery_saver() {
    for d in "${BATTERY_HOG_DAEMONS[@]}"; do
        local plist="/System/Library/LaunchDaemons/$d.plist"
        if [ -f "$plist" ]; then
            sudo launchctl load "$plist" >/dev/null 2>&1
        fi
    done
}

throttle_bandwidth_thieves() {
    local thieves=("nsurlsessiond" "appstored" "assetsd" "cloudd" "softwareupdated")
    for t in "${thieves[@]}"; do
        local pids=$(/bin/ps -A -o pid,comm 2>/dev/null | awk -v pat="$t" '$0 ~ pat && !/(awk|grep|shield)/ {print $1}')
        for p in $pids; do
            if [ -n "$p" ] && [ "$p" -gt 1 ]; then
                sudo renice 10 -p "$p" >/dev/null 2>&1
            fi
        done
    done
}

purge_inactive_memory() {
    if which purge >/dev/null 2>&1; then
        sudo purge >/dev/null 2>&1
    elif [ -x "${JB}/usr/bin/purge" ]; then
        sudo "${JB}/usr/bin/purge" >/dev/null 2>&1
    fi
}

clean_storage_and_caches() {
    PYTHON_EXEC="${JB}/usr/bin/python3"
    [ ! -x "$PYTHON_EXEC" ] && PYTHON_EXEC="python3"
    "$PYTHON_EXEC" - <<'PY_CLEAN_END'
import os

dirs_to_clean = [
    '/var/mobile/Library/Logs/CrashReporter',
    '/var/mobile/Library/Logs/DiagnosticReports',
    '/var/mobile/Library/Caches/com.apple.AppleMediaServices',
    '/var/mobile/Library/Caches/GeoServices',
    '/var/mobile/Library/Caches/CloudKit',
    '/var/mobile/Library/Caches/com.apple.QuickLook.thumbnailcache',
    '/var/mobile/Library/Caches/com.apple.rtcreporting',
    '/var/mobile/Library/Caches/com.apple.routined',
    '/var/mobile/Library/Caches/com.apple.parsecd',
    '/var/mobile/Library/Caches/com.apple.geod',
    '/var/mobile/Library/Caches/com.apple.tipsd',
    '/var/mobile/Library/Caches/com.apple.Safari.SafeBrowsing',
    '/var/mobile/Library/Caches/com.apple.iTunesCloud',
    '/var/mobile/Library/Caches/com.apple.remindd',
    '/var/log/asl',
    '/var/tmp',
]

total_bytes = 0
file_count = 0

for d in dirs_to_clean:
    if os.path.exists(d):
        for root, dirs, files in os.walk(d):
            for f in files:
                fp = os.path.join(root, f)
                try:
                    sz = os.path.getsize(fp)
                    os.remove(fp)
                    total_bytes += sz
                    file_count += 1
                except:
                    pass

mb = total_bytes / (1024 * 1024)
print(f"CLEANED:{file_count}:{mb:.1f}MB")
PY_CLEAN_END
}

manage_turbo() {
    local cmd="$1"
    PYTHON_EXEC="${JB}/usr/bin/python3"
    [ ! -x "$PYTHON_EXEC" ] && PYTHON_EXEC="python3"
    "$PYTHON_EXEC" - "$cmd" <<'PY_TURBO_END'
import sys, ctypes

cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
try:
    ax = ctypes.cdll.LoadLibrary('/System/Library/PrivateFrameworks/AccessibilityUtilities.framework/AccessibilityUtilities')
    ax._AXSSetReduceMotionEnabled.argtypes = [ctypes.c_bool]
    ax._AXSSetEnhanceBackgroundContrastEnabled.argtypes = [ctypes.c_bool]
    
    if cmd in ("enable", "on", "1"):
        ax._AXSSetReduceMotionEnabled(True)
        ax._AXSSetEnhanceBackgroundContrastEnabled(True)
        print("TURBO_ENABLED")
    elif cmd in ("disable", "off", "0"):
        ax._AXSSetReduceMotionEnabled(False)
        ax._AXSSetEnhanceBackgroundContrastEnabled(False)
        print("TURBO_DISABLED")
    else:
        motion = bool(ax._AXSReduceMotionEnabled())
        contrast = bool(ax._AXSEnhanceBackgroundContrastEnabled())
        if motion and contrast:
            print("TURBO_ACTIVE")
        else:
            print("TURBO_INACTIVE")
except Exception as e:
    print(f"TURBO_ERROR:{e}")
PY_TURBO_END
}

apply_optimizations() {
    local target_mode="$1"
    resolve_gateway

    # 1. Battery Saver & Telemetry Defense
    apply_battery_saver

    # 2. Wi-Fi Stealth & Anti-Reconnaissance Blackholing
    sudo sysctl -w net.inet.tcp.blackhole=2 >/dev/null 2>&1
    sudo sysctl -w net.inet.udp.blackhole=1 >/dev/null 2>&1
    sudo sysctl -w net.inet.icmp.drop_redirect=1 >/dev/null 2>&1
    sudo sysctl -w net.inet.ip.redirect=0 >/dev/null 2>&1
    sudo sysctl -w net.inet6.icmp6.rediraccept=0 >/dev/null 2>&1
    sudo sysctl -w net.inet.tcp.drop_synfin=1 >/dev/null 2>&1

    # 3. Universal Zero-Trust Hardware Static ARP Lock
    if [ -n "$ROUTER_IP" ] && [ -n "$ROUTER_MAC" ]; then
        sudo arp -d "$ROUTER_IP" ifscope "$INTERFACE" >/dev/null 2>&1
        sudo arp -s "$ROUTER_IP" "$ROUTER_MAC" ifscope "$INTERFACE" >/dev/null 2>&1
    fi

    # 4. Throttle background bandwidth thieves (No Wi-Fi theft during games/streams)
    throttle_bandwidth_thieves

    # 5. Broadcom Wi-Fi WMM / DSCP VIP QoS Fast-Path
    sudo sysctl -w net.qos.policy.wifi_enabled=1 >/dev/null 2>&1
    sudo sysctl -w net.qos.policy.capable_enabled=1 >/dev/null 2>&1
    sudo sysctl -w net.qos.reset_dscp_to_wifi_ac_map=1 >/dev/null 2>&1

    # 6. Disable AWDL / AirDrop scans during session to eliminate micro-stutters
    sudo ifconfig awdl0 down >/dev/null 2>&1
    sudo ifconfig llw0 down >/dev/null 2>&1

    # 7. Flush DNS resolver cache
    sudo killall -HUP mDNSResponder >/dev/null 2>&1

    # 8. Anti-Jetsam Memory Shield & Low-Latency Socket Tuning
    sudo sysctl -w kern.memorystatus_purge_on_warning=1 >/dev/null 2>&1
    sudo sysctl -w kern.memorystatus_apps_idle_delay_time=30 >/dev/null 2>&1
    sudo sysctl -w net.inet.tcp.always_keepalive=1 >/dev/null 2>&1
    sudo sysctl -w net.inet.tcp.keepidle=30000 >/dev/null 2>&1

    # 9. Throttle background indexing & storage churn
    for bg_daemon in corespotlightd knowledgeconstructiond deleted cloudphotod; do
        BG_PIDS=$(/bin/ps -A -o pid,comm 2>/dev/null | awk -v d="$bg_daemon" '$0 ~ d && !/awk/ {print $1}')
        for bg_p in $BG_PIDS; do
            [ -n "$bg_p" ] && sudo renice 15 -p "$bg_p" >/dev/null 2>&1
        done
    done

    # 10. Kernel TCP / UDP Buffer & TSO Offload Tuning
    if [ "$target_mode" = "gaming" ]; then
        # Gaming: Instant ACK (0ms), TSO Off (Anti-Bufferbloat), Tight Buffers, somaxconn=512
        sudo sysctl -w net.inet.tcp.tso=0 >/dev/null 2>&1
        sudo sysctl -w net.inet.tcp.delayed_ack=0 >/dev/null 2>&1
        sudo sysctl -w net.inet.tcp.sendspace=2097152 >/dev/null 2>&1
        sudo sysctl -w net.inet.tcp.recvspace=2097152 >/dev/null 2>&1
        sudo sysctl -w net.inet.tcp.autorcvbufmax=4194304 >/dev/null 2>&1
        sudo sysctl -w net.inet.tcp.autosndbufmax=4194304 >/dev/null 2>&1
        sudo sysctl -w net.inet.udp.recvspace=2097152 >/dev/null 2>&1
        sudo sysctl -w net.inet.udp.maxdgram=65535 >/dev/null 2>&1
        sudo sysctl -w kern.ipc.somaxconn=512 >/dev/null 2>&1
    else
        # Streaming: TSO Burst, 6MB Retina Dynamic Buffer, somaxconn=512, Stremio VIP
        sudo sysctl -w net.inet.tcp.tso=1 >/dev/null 2>&1
        sudo sysctl -w net.inet.tcp.delayed_ack=2 >/dev/null 2>&1
        sudo sysctl -w net.inet.tcp.sendspace=2097152 >/dev/null 2>&1
        sudo sysctl -w net.inet.tcp.recvspace=4194304 >/dev/null 2>&1
        sudo sysctl -w net.inet.tcp.autorcvbufmax=6291456 >/dev/null 2>&1
        sudo sysctl -w net.inet.tcp.autosndbufmax=6291456 >/dev/null 2>&1
        sudo sysctl -w net.inet.udp.recvspace=4194304 >/dev/null 2>&1
        sudo sysctl -w net.inet.udp.maxdgram=65535 >/dev/null 2>&1
        sudo sysctl -w kern.ipc.somaxconn=512 >/dev/null 2>&1
    fi

    # 10. Reclaim Inactive Memory (RAM Purge)
    purge_inactive_memory

    # 11. Hardware Media & Audio Decoder Boost
    MS_PID=$(/bin/ps -A -o pid,comm 2>/dev/null | awk '/mediaserverd/ && !/awk/ {print $1}')
    if [ -n "$MS_PID" ]; then
        sudo renice -10 -p "$MS_PID" >/dev/null 2>&1
    fi
}

revert_optimizations() {
    sudo sysctl -w net.inet.tcp.blackhole=0 >/dev/null 2>&1
    sudo sysctl -w net.inet.udp.blackhole=0 >/dev/null 2>&1
    sudo sysctl -w net.inet.tcp.tso=1 >/dev/null 2>&1
    sudo sysctl -w net.inet.tcp.delayed_ack=3 >/dev/null 2>&1
    sudo sysctl -w net.inet.tcp.sendspace=131072 >/dev/null 2>&1
    sudo sysctl -w net.inet.tcp.recvspace=131072 >/dev/null 2>&1
    sudo sysctl -w net.inet.tcp.autorcvbufmax=2097152 >/dev/null 2>&1
    sudo sysctl -w net.inet.tcp.autosndbufmax=2097152 >/dev/null 2>&1
    sudo sysctl -w net.inet.udp.recvspace=786896 >/dev/null 2>&1
    sudo sysctl -w net.inet.icmp.drop_redirect=0 >/dev/null 2>&1
    sudo sysctl -w net.inet.ip.redirect=1 >/dev/null 2>&1
    sudo sysctl -w kern.ipc.somaxconn=128 >/dev/null 2>&1

    sudo sysctl -w net.qos.policy.wifi_enabled=0 >/dev/null 2>&1
    sudo sysctl -w net.qos.policy.capable_enabled=0 >/dev/null 2>&1
    sudo sysctl -w net.qos.reset_dscp_to_wifi_ac_map=0 >/dev/null 2>&1

    sudo ifconfig awdl0 up >/dev/null 2>&1
    sudo ifconfig llw0 up >/dev/null 2>&1

    for bg_daemon in corespotlightd knowledgeconstructiond deleted cloudphotod nsurlsessiond appstored assetsd cloudd; do
        BG_PIDS=$(/bin/ps -A -o pid,comm 2>/dev/null | awk -v d="$bg_daemon" '$0 ~ d && !/awk/ {print $1}')
        for bg_p in $BG_PIDS; do
            [ -n "$bg_p" ] && sudo renice 0 -p "$bg_p" >/dev/null 2>&1
        done
    done

    MS_PID=$(/bin/ps -A -o pid,comm 2>/dev/null | awk '/mediaserverd/ && !/awk/ {print $1}')
    if [ -n "$MS_PID" ]; then
        sudo renice 0 -p "$MS_PID" >/dev/null 2>&1
    fi

    revert_battery_saver
}

SHIELD_EXEC="${JB}/usr/bin/shield_ctl"
[ ! -f "$SHIELD_EXEC" ] && SHIELD_EXEC="/usr/bin/shield_ctl"
BASH_EXEC="${JB}/usr/bin/bash"
[ ! -x "$BASH_EXEC" ] && BASH_EXEC="/bin/bash"
[ ! -x "$BASH_EXEC" ] && BASH_EXEC="bash"

case "$ACTION" in
    start)
        if [ -f "$PID_FILE" ]; then
            OLD_WPID=$(cat "$PID_FILE" 2>/dev/null)
            [ -n "$OLD_WPID" ] && kill "$OLD_WPID" 2>/dev/null
            rm -f "$PID_FILE"
        fi
        for p in $(/bin/ps -A -o pid,command 2>/dev/null | awk '/shield_ctl _watchdog/ && !/awk/ {print $1}'); do
            kill "$p" 2>/dev/null
        done

        apply_optimizations "$MODE"

        mkdir -p /var/mobile/Library/Caches
        echo "ACTIVE:$MODE:$APP_PID" > "$STATE_FILE"

        nohup "$BASH_EXEC" "$SHIELD_EXEC" _watchdog "$APP_PID" "$ROUTER_IP" "$INTERFACE" "$ROUTER_MAC" >/dev/null 2>&1 &
        echo $! > "$PID_FILE"

        echo "SHIELD_STARTED:$MODE"
        ;;

    start_daemon)
        apply_optimizations "$MODE"

        mkdir -p /var/mobile/Library/Caches
        echo "ACTIVE:$MODE:DAEMON" > "$STATE_FILE"

        exec "$BASH_EXEC" "$SHIELD_EXEC" _watchdog "DAEMON" "$ROUTER_IP" "$INTERFACE" "$ROUTER_MAC"
        ;;

    _watchdog)
        TARGET_PID="$2"
        ROUTER="$3"
        IFACE="$4"
        GATEWAY_MAC_AUTH="$5"

        VIP_PATTERN="(Stremio|NodeMobile|stremio-runtime|stremio-service|ffmpeg|YouTube|PrimeVideo|Dominguez|Argo|Max-iOS|Netflix|Disney|Twitch|Infuse|VLC|Kodi|Plex|Roblox|PojavLauncher|Minecraft|Flycast|Delta|RetroArch|PPSSPP|Provenance|Moonlight|Sunshine|GeForceNOW|Chiaki|SteamLink|Shadow|Discord)"

        LOOP_COUNT=0
        while true; do
            if [ "$TARGET_PID" != "DAEMON" ] && [ -n "$TARGET_PID" ] && [ "$TARGET_PID" -gt 1 ]; then
                if ! kill -0 "$TARGET_PID" 2>/dev/null; then
                    break
                fi
            fi

            # 1. Zero-Trust Anti-Spoof Sentinel: Re-lock gateway if poisoned or altered
            if [ -n "$ROUTER" ] && [ -n "$GATEWAY_MAC_AUTH" ]; then
                ARP_ENTRY=$(arp -n "$ROUTER" 2>/dev/null | tr "[:upper:]" "[:lower:]")
                CURRENT_RAW_MAC=$(echo "$ARP_ENTRY" | awk '/at/ {for(i=1;i<=NF;i++) if($i=="at") print $(i+1)}')
                CURRENT_NORM_MAC=$(norm_mac "$CURRENT_RAW_MAC")
                if [[ "$CURRENT_NORM_MAC" != "$GATEWAY_MAC_AUTH" ]] || [[ "$ARP_ENTRY" != *"permanent"* ]] || [[ "$ARP_ENTRY" == *"no entry"* ]]; then
                    sudo arp -d "$ROUTER" ifscope "$IFACE" >/dev/null 2>&1
                    sudo arp -s "$ROUTER" "$GATEWAY_MAC_AUTH" ifscope "$IFACE" >/dev/null 2>&1
                fi
            fi

            # 2. Throttle background bandwidth thieves (nsurlsessiond, appstored, etc.)
            throttle_bandwidth_thieves

            # 3. Auto-Renice all streaming, gaming & Stremio VIP processes to -20
            APP_PIDS=$(/bin/ps -A -o pid,command 2>/dev/null | awk -v pat="$VIP_PATTERN" '$0 ~ pat && !/(awk|grep|shield)/ {print $1}')
            for p in $APP_PIDS; do
                if [ -n "$p" ] && [ "$p" -gt 1 ]; then
                    sudo renice -20 -p "$p" >/dev/null 2>&1
                fi
            done

            # 4. Keep mediaserverd prioritized
            MS_PID=$(/bin/ps -A -o pid,comm 2>/dev/null | awk '/mediaserverd/ && !/awk/ {print $1}')
            if [ -n "$MS_PID" ]; then
                sudo renice -10 -p "$MS_PID" >/dev/null 2>&1
            fi

            # Periodic memory refresh every ~2 minutes
            LOOP_COUNT=$((LOOP_COUNT + 1))
            if [ $LOOP_COUNT -ge 40 ]; then
                purge_inactive_memory
                LOOP_COUNT=0
            fi

            sleep 3
        done

        if [ "$TARGET_PID" != "DAEMON" ]; then
            "$SHIELD_EXEC" stop
        fi
        ;;

    stop)
        if [ -f "$PID_FILE" ]; then
            WPID=$(cat "$PID_FILE" 2>/dev/null)
            [ -n "$WPID" ] && kill "$WPID" 2>/dev/null
            rm -f "$PID_FILE"
        fi
        for p in $(/bin/ps -A -o pid,command 2>/dev/null | awk '/shield_ctl _watchdog/ && !/awk/ {print $1}'); do
            kill "$p" 2>/dev/null
        done

        revert_optimizations

        rm -f "$STATE_FILE"
        echo "SHIELD_STOPPED"
        ;;

    purge)
        purge_inactive_memory
        echo "RAM_PURGED"
        ;;

    clean|deepclean)
        clean_storage_and_caches
        ;;

    turbo)
        manage_turbo "$2"
        ;;

    stremio_status)
        STREAM_COUNT=$(netstat -an 2>/dev/null | awk '/11470/ && /ESTABLISHED/ {count++} END {print count+0}')
        echo "STREMIO_STREAMS:$STREAM_COUNT"
        ;;

    battery)
        SUB="$2"
        case "$SUB" in
            enable)
                apply_battery_saver
                echo "BATTERY_SAVER_ENABLED"
                ;;
            disable)
                revert_battery_saver
                echo "BATTERY_SAVER_DISABLED"
                ;;
            status)
                UNLOADED=0
                for d in "${BATTERY_HOG_DAEMONS[@]}"; do
                    if ! launchctl list 2>/dev/null | grep -q "$d"; then
                        UNLOADED=$((UNLOADED + 1))
                    fi
                done
                echo "BATTERY_SAVER_ACTIVE:$UNLOADED/${#BATTERY_HOG_DAEMONS[@]}"
                ;;
        esac
        ;;

    config)
        SUB="$2"
        resolve_gateway
        case "$SUB" in
            set)
                NEW_IP="$3"
                NEW_MAC="$4"
                if [ -n "$NEW_IP" ] && [ -n "$NEW_MAC" ]; then
                    NORM_M=$(norm_mac "$NEW_MAC")
                    CUR_GH=$(grep "^GITHUB_URL=" "$CONF_FILE" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]')
                    [ -z "$CUR_GH" ] && CUR_GH="https://github.com/NightKnight24"
                    cat <<EOF > "$CONF_FILE"
GATEWAY_IP=$NEW_IP
GATEWAY_MAC=$NORM_M
BANDWIDTH_SENTINEL=enabled
BATTERY_SAVER=enabled
GITHUB_URL=$CUR_GH
EOF
                    echo "CONFIG_SAVED:IP=$NEW_IP:MAC=$NORM_M"
                else
                    echo "Usage: $0 config set <gateway_ip> <gateway_mac>"
                fi
                ;;
            set-github)
                NEW_GH="$3"
                if [ -n "$NEW_GH" ]; then
                    init_config
                    grep -v "^GITHUB_URL=" "$CONF_FILE" > "${CONF_FILE}.tmp" 2>/dev/null && mv "${CONF_FILE}.tmp" "$CONF_FILE"
                    echo "GITHUB_URL=$NEW_GH" >> "$CONF_FILE"
                    echo "CONFIG_SAVED:GITHUB_URL=$NEW_GH"
                else
                    echo "Usage: $0 config set-github <url>"
                fi
                ;;
            auto)
                CUR_GH=$(grep "^GITHUB_URL=" "$CONF_FILE" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]')
                [ -z "$CUR_GH" ] && CUR_GH="https://github.com/NightKnight24"
                cat <<EOF > "$CONF_FILE"
GATEWAY_IP=auto
GATEWAY_MAC=auto
BANDWIDTH_SENTINEL=enabled
BATTERY_SAVER=enabled
GITHUB_URL=$CUR_GH
EOF
                resolve_gateway
                echo "CONFIG_AUTO_RESET:IP=$ROUTER_IP:MAC=$ROUTER_MAC"
                ;;
            get|show|*)
                init_config
                CFG_IP=$(grep "^GATEWAY_IP=" "$CONF_FILE" 2>/dev/null | cut -d= -f2 | tr -d '[:space:]')
                CFG_MAC=$(grep "^GATEWAY_MAC=" "$CONF_FILE" 2>/dev/null | cut -d= -f2 | tr -d '[:space:]')
                CFG_GH=$(grep "^GITHUB_URL=" "$CONF_FILE" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]')
                echo "MODE=${CFG_IP:-auto}"
                echo "ROUTER_IP=$ROUTER_IP"
                echo "ROUTER_MAC=$ROUTER_MAC"
                echo "BANDWIDTH_SENTINEL=active"
                echo "GITHUB_URL=${CFG_GH:-https://github.com/NightKnight24}"
                ;;
        esac
        ;;

    run|hud|interactive)
        RUN_MODE="${2:-streaming}"
        apply_optimizations "$RUN_MODE"
        trap 'revert_optimizations; echo -e "\n\033[1;32m[✔] Defaults restored.\033[0m"; exit 0' SIGHUP SIGINT SIGTERM EXIT
        export SHIELD_MODE_ENV="$RUN_MODE"
        export ROUTER_IP_ENV="$ROUTER_IP"
        export ROUTER_MAC_ENV="$ROUTER_MAC"
        
        PYTHON_EXEC="${JB}/usr/bin/python3"
        [ ! -x "$PYTHON_EXEC" ] && PYTHON_EXEC="python3"
        
        "$PYTHON_EXEC" - <<'PY_CLI_END'
import os, sys, time, subprocess

mode = os.environ.get("SHIELD_MODE_ENV", "streaming")
router_ip = os.environ.get("ROUTER_IP_ENV", "192.168.0.1")
router_mac = os.environ.get("ROUTER_MAC_ENV", "auto")

C_RESET = '\033[0m'
C_GREEN = '\033[0;32m'
C_BRIGHT_GREEN = '\033[1;32m'
C_YELLOW = '\033[1;33m'
C_RED = '\033[0;31m'
C_CYAN = '\033[1;36m'
C_MAGENTA = '\033[1;35m'
C_GRAY = '\033[0;37m'

targets = [
    "Stremio", "NodeMobile", "node", "ffmpeg", "YouTube", "Netflix", "PrimeVideo",
    "Disney", "Twitch", "Infuse", "VLC", "Kodi", "Plex", "Roblox", "Minecraft",
