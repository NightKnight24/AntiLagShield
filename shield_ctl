#!/bin/sh
# ==============================================================================
# 🛡️ Anti-Lag Shield Pro v3.9 Controller (Zero-Stutter & Passive Sentinel)
# High Performance Network Engine for iPadOS & iOS
# ==============================================================================

if [ -z "$BASH_VERSION" ]; then
    for b in /var/jb/usr/bin/bash /usr/bin/bash /bin/bash /var/jb/bin/bash; do
        if [ -x "$b" ]; then exec "$b" "$0" "$@"; fi
    done
fi

if [ -d "/var/jb" ]; then
    JB="/var/jb"
else
    JB=""
fi

export PATH="${JB}/usr/bin:${JB}/bin:${JB}/usr/sbin:${JB}/sbin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

CONF_FILE="/var/mobile/Library/Preferences/com.jordan.antilagshield.conf"
STATE_FILE="/var/mobile/Library/Caches/shield_state.txt"
PID_FILE="/var/mobile/Library/Caches/shield_watchdog.pid"

ACTION="$1"
MODE="${2:-streaming}"

INTERFACE="en0"

init_config() {
    if [ ! -f "$CONF_FILE" ]; then
        mkdir -p "$(dirname "$CONF_FILE")" 2>/dev/null
        cat <<EOF > "$CONF_FILE"
GATEWAY_IP=auto
GATEWAY_MAC=auto
BANDWIDTH_SENTINEL=enabled
BATTERY_SAVER=enabled
GITHUB_URL=https://github.com/NightKnight24
EOF
    fi
}

norm_mac() {
    local IFS=:
    local parts=($1)
    local out=""
    for p in "${parts[@]}"; do
        [ ${#p} -eq 1 ] && p="0$p"
        out="${out}${out:+:}$p"
    done
    echo "$out"
}

resolve_gateway() {
    init_config
    local cfg_ip=$(grep "^GATEWAY_IP=" "$CONF_FILE" 2>/dev/null | cut -d= -f2 | tr -d '[:space:]')
    local cfg_mac=$(grep "^GATEWAY_MAC=" "$CONF_FILE" 2>/dev/null | cut -d= -f2 | tr -d '[:space:]')

    DETECTED_IFACE=$(route -n get default 2>/dev/null | awk '/interface:/ {print $2}')
    [ -n "$DETECTED_IFACE" ] && INTERFACE="$DETECTED_IFACE"

    if [ -z "$cfg_ip" ] || [ "$cfg_ip" = "auto" ]; then
        ROUTER_IP=$(route -n get default 2>/dev/null | awk '/gateway:/ {print $2}')
        [ -z "$ROUTER_IP" ] && ROUTER_IP="192.168.0.1"
    else
        ROUTER_IP="$cfg_ip"
    fi

    if [ -z "$cfg_mac" ] || [ "$cfg_mac" = "auto" ]; then
        ping -c 1 -W 300 "$ROUTER_IP" >/dev/null 2>&1
        local raw_mac=$(arp -n "$ROUTER_IP" 2>/dev/null | awk '/at/ {for(i=1;i<=NF;i++) if($i=="at") print $(i+1)}')
        if [ -n "$raw_mac" ]; then
            ROUTER_MAC=$(norm_mac "$raw_mac")
        else
            ROUTER_MAC=""
        fi
    else
        ROUTER_MAC=$(norm_mac "$cfg_mac")
    fi
}

purge_inactive_memory() {
    if which purge >/dev/null 2>&1; then
        sudo purge >/dev/null 2>&1
    elif [ -x "${JB}/usr/bin/purge" ]; then
        sudo "${JB}/usr/bin/purge" >/dev/null 2>&1
    fi
}

clean_storage_and_caches() {
    PYTHON_EXEC="${JB}/usr/bin/python3"
    [ ! -x "$PYTHON_EXEC" ] && PYTHON_EXEC="python3"
    "$PYTHON_EXEC" - <<'PY_CLEAN_END'
import os

dirs_to_clean = [
    '/var/mobile/Library/Logs/CrashReporter',
    '/var/mobile/Library/Logs/DiagnosticReports',
    '/var/mobile/Library/Caches/com.apple.AppleMediaServices',
    '/var/mobile/Library/Caches/GeoServices',
    '/var/mobile/Library/Caches/CloudKit',
    '/var/mobile/Library/Caches/com.apple.QuickLook.thumbnailcache',
    '/var/mobile/Library/Caches/com.apple.rtcreporting',
    '/var/mobile/Library/Caches/com.apple.routined',
    '/var/mobile/Library/Caches/com.apple.parsecd',
    '/var/mobile/Library/Caches/com.apple.geod',
    '/var/mobile/Library/Caches/com.apple.tipsd',
    '/var/mobile/Library/Caches/com.apple.Safari.SafeBrowsing',
    '/var/mobile/Library/Caches/com.apple.iTunesCloud',
    '/var/mobile/Library/Caches/com.apple.remindd',
    '/var/log/asl',
    '/var/tmp',
]

total_bytes = 0
file_count = 0

for d in dirs_to_clean:
    if os.path.exists(d):
        for root, dirs, files in os.walk(d):
            for f in files:
                fp = os.path.join(root, f)
                try:
                    sz = os.path.getsize(fp)
                    os.remove(fp)
                    total_bytes += sz
                    file_count += 1
                except:
                    pass

mb = total_bytes / (1024 * 1024)
print(f"CLEANED:{file_count}:{mb:.1f}MB")
PY_CLEAN_END
}

manage_turbo() {
    local cmd="$1"
    PYTHON_EXEC="${JB}/usr/bin/python3"
    [ ! -x "$PYTHON_EXEC" ] && PYTHON_EXEC="python3"
    "$PYTHON_EXEC" - "$cmd" <<'PY_TURBO_END'
import sys, ctypes

cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
try:
    ax = ctypes.cdll.LoadLibrary('/System/Library/PrivateFrameworks/AccessibilityUtilities.framework/AccessibilityUtilities')
    ax._AXSSetReduceMotionEnabled.argtypes = [ctypes.c_bool]
    ax._AXSSetEnhanceBackgroundContrastEnabled.argtypes = [ctypes.c_bool]
    
    if cmd in ("enable", "on", "1"):
        ax._AXSSetReduceMotionEnabled(True)
        ax._AXSSetEnhanceBackgroundContrastEnabled(True)
        print("TURBO_ENABLED")
    elif cmd in ("disable", "off", "0"):
        ax._AXSSetReduceMotionEnabled(False)
        ax._AXSSetEnhanceBackgroundContrastEnabled(False)
        print("TURBO_DISABLED")
    else:
        motion = bool(ax._AXSReduceMotionEnabled())
        contrast = bool(ax._AXSEnhanceBackgroundContrastEnabled())
        if motion and contrast:
            print("TURBO_ACTIVE")
        else:
            print("TURBO_INACTIVE")
except Exception as e:
    print(f"TURBO_ERROR:{e}")
PY_TURBO_END
}

apply_optimizations() {
    local target_mode="$1"
    resolve_gateway

    # 1. Hardware Static ARP Lock (Locks gateway into kernel routing table permanently)
    if [ -n "$ROUTER_IP" ] && [ -n "$ROUTER_MAC" ]; then
        sudo arp -s "$ROUTER_IP" "$ROUTER_MAC" ifscope "$INTERFACE" >/dev/null 2>&1
    fi

    # 2. Stealth & Anti-Reconnaissance Blackholing
    sudo sysctl -w net.inet.tcp.blackhole=2 >/dev/null 2>&1
    sudo sysctl -w net.inet.udp.blackhole=1 >/dev/null 2>&1
    sudo sysctl -w net.inet.icmp.drop_redirect=1 >/dev/null 2>&1
    sudo sysctl -w net.inet.ip.redirect=0 >/dev/null 2>&1
    sudo sysctl -w net.inet6.icmp6.rediraccept=0 >/dev/null 2>&1
    sudo sysctl -w net.inet.tcp.drop_synfin=1 >/dev/null 2>&1

    # 3. Disable Enterprise DSCP Wi-Fi tagging on home router (Prevents Wi-Fi packet drops)
    sudo sysctl -w net.qos.policy.wifi_enabled=0 >/dev/null 2>&1
    sudo sysctl -w net.qos.policy.capable_enabled=0 >/dev/null 2>&1
    sudo sysctl -w net.qos.reset_dscp_to_wifi_ac_map=0 >/dev/null 2>&1

    # 4. Anti-Jetsam Buffer Protection & Socket Tuning
    sudo sysctl -w kern.memorystatus_purge_on_warning=0 >/dev/null 2>&1
    sudo sysctl -w net.inet.tcp.always_keepalive=1 >/dev/null 2>&1
    sudo sysctl -w net.inet.tcp.keepidle=30000 >/dev/null 2>&1
    sudo sysctl -w kern.ipc.somaxconn=512 >/dev/null 2>&1

    # 5. Kernel TCP / UDP Buffer & TSO Offload Tuning
    if [ "$target_mode" = "gaming" ]; then
        # Gaming: Instant ACK (0ms), TSO Off (Anti-Bufferbloat), somaxconn=512
        sudo sysctl -w net.inet.tcp.tso=0 >/dev/null 2>&1
        sudo sysctl -w net.inet.tcp.delayed_ack=0 >/dev/null 2>&1
        sudo sysctl -w net.inet.tcp.sendspace=131072 >/dev/null 2>&1
        sudo sysctl -w net.inet.tcp.recvspace=131072 >/dev/null 2>&1
        sudo sysctl -w net.inet.tcp.autorcvbufmax=2097152 >/dev/null 2>&1
        sudo sysctl -w net.inet.tcp.autosndbufmax=2097152 >/dev/null 2>&1
        sudo sysctl -w net.inet.udp.recvspace=1048576 >/dev/null 2>&1
        sudo sysctl -w net.inet.udp.maxdgram=65535 >/dev/null 2>&1
    else
        # Streaming: Adaptive ACK (RFC compliant, no Wi-Fi ACK floods), TSO Burst, 4MB Buffers
        sudo sysctl -w net.inet.tcp.tso=1 >/dev/null 2>&1
        sudo sysctl -w net.inet.tcp.delayed_ack=3 >/dev/null 2>&1
        sudo sysctl -w net.inet.tcp.sendspace=262144 >/dev/null 2>&1
        sudo sysctl -w net.inet.tcp.recvspace=524288 >/dev/null 2>&1
        sudo sysctl -w net.inet.tcp.autorcvbufmax=4194304 >/dev/null 2>&1
        sudo sysctl -w net.inet.tcp.autosndbufmax=4194304 >/dev/null 2>&1
        sudo sysctl -w net.inet.udp.recvspace=2097152 >/dev/null 2>&1
        sudo sysctl -w net.inet.udp.maxdgram=65535 >/dev/null 2>&1
    fi

    # 6. Prioritize current running media / gaming VIPs once (no polling loop!)
    VIP_PATTERN="(Stremio|NodeMobile|stremio-runtime|stremio-service|ffmpeg|YouTube|PrimeVideo|Netflix|Disney|Twitch|Infuse|VLC|Kodi|Plex|Roblox|PojavLauncher|Minecraft|Delta|RetroArch|PPSSPP|Moonlight|GeForceNOW|SteamLink)"
    APP_PIDS=$(/bin/ps -A -o pid,command 2>/dev/null | awk -v pat="$VIP_PATTERN" '$0 ~ pat && !/(awk|grep|shield)/ {print $1}')
    for p in $APP_PIDS; do
        if [ -n "$p" ] && [ "$p" -gt 1 ]; then
            sudo renice -10 -p "$p" >/dev/null 2>&1
        fi
    done
    MS_PID=$(/bin/ps -A -o pid,comm 2>/dev/null | awk '/mediaserverd/ && !/awk/ {print $1}')
    if [ -n "$MS_PID" ]; then
        sudo renice -10 -p "$MS_PID" >/dev/null 2>&1
    fi
}

revert_optimizations() {
    sudo sysctl -w net.inet.tcp.blackhole=0 >/dev/null 2>&1
    sudo sysctl -w net.inet.udp.blackhole=0 >/dev/null 2>&1
    sudo sysctl -w net.inet.tcp.tso=1 >/dev/null 2>&1
    sudo sysctl -w net.inet.tcp.delayed_ack=3 >/dev/null 2>&1
    sudo sysctl -w net.inet.tcp.sendspace=131072 >/dev/null 2>&1
    sudo sysctl -w net.inet.tcp.recvspace=131072 >/dev/null 2>&1
    sudo sysctl -w net.inet.tcp.autorcvbufmax=2097152 >/dev/null 2>&1
    sudo sysctl -w net.inet.tcp.autosndbufmax=2097152 >/dev/null 2>&1
    sudo sysctl -w net.inet.udp.recvspace=786896 >/dev/null 2>&1
    sudo sysctl -w net.inet.icmp.drop_redirect=0 >/dev/null 2>&1
    sudo sysctl -w net.inet.ip.redirect=1 >/dev/null 2>&1
    sudo sysctl -w kern.ipc.somaxconn=128 >/dev/null 2>&1
    sudo sysctl -w kern.memorystatus_purge_on_warning=0 >/dev/null 2>&1
    sudo sysctl -w net.qos.policy.wifi_enabled=0 >/dev/null 2>&1
    sudo sysctl -w net.qos.policy.capable_enabled=0 >/dev/null 2>&1
    sudo sysctl -w net.qos.reset_dscp_to_wifi_ac_map=0 >/dev/null 2>&1

    MS_PID=$(/bin/ps -A -o pid,comm 2>/dev/null | awk '/mediaserverd/ && !/awk/ {print $1}')
    if [ -n "$MS_PID" ]; then
        sudo renice 0 -p "$MS_PID" >/dev/null 2>&1
    fi
}

SHIELD_EXEC="${JB}/usr/bin/shield_ctl"
[ ! -f "$SHIELD_EXEC" ] && SHIELD_EXEC="/usr/bin/shield_ctl"
BASH_EXEC="${JB}/usr/bin/bash"
[ ! -x "$BASH_EXEC" ] && BASH_EXEC="/bin/bash"
[ ! -x "$BASH_EXEC" ] && BASH_EXEC="bash"

case "$ACTION" in
    start|start_daemon)
        apply_optimizations "$MODE"
        mkdir -p /var/mobile/Library/Caches 2>/dev/null
        echo "ACTIVE:$MODE" > "$STATE_FILE"
        echo "SHIELD_STARTED:$MODE"
        ;;

    stop)
        revert_optimizations
        rm -f "$STATE_FILE" 2>/dev/null
        echo "SHIELD_STOPPED"
        ;;

    purge)
        purge_inactive_memory
        echo "RAM_PURGED"
        ;;

    clean|deepclean)
        clean_storage_and_caches
        ;;

    turbo)
        manage_turbo "$2"
        ;;

    stremio_status)
        STREAM_COUNT=$(netstat -an 2>/dev/null | awk '/11470/ && /ESTABLISHED/ {count++} END {print count+0}')
        echo "STREMIO_STREAMS:$STREAM_COUNT"
        ;;

    config)
        SUB="$2"
        resolve_gateway
        case "$SUB" in
            set)
                NEW_IP="$3"
                NEW_MAC="$4"
                if [ -n "$NEW_IP" ] && [ -n "$NEW_MAC" ]; then
                    NORM_M=$(norm_mac "$NEW_MAC")
                    CUR_GH=$(grep "^GITHUB_URL=" "$CONF_FILE" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]')
                    [ -z "$CUR_GH" ] && CUR_GH="https://github.com/NightKnight24"
                    cat <<EOF > "$CONF_FILE"
GATEWAY_IP=$NEW_IP
GATEWAY_MAC=$NORM_M
BANDWIDTH_SENTINEL=enabled
BATTERY_SAVER=enabled
GITHUB_URL=$CUR_GH
EOF
                    echo "CONFIG_SAVED:IP=$NEW_IP:MAC=$NORM_M"
                else
                    echo "Usage: $0 config set <gateway_ip> <gateway_mac>"
                fi
                ;;
            set-github)
                NEW_GH="$3"
                if [ -n "$NEW_GH" ]; then
                    init_config
                    grep -v "^GITHUB_URL=" "$CONF_FILE" > "${CONF_FILE}.tmp" 2>/dev/null && mv "${CONF_FILE}.tmp" "$CONF_FILE"
                    echo "GITHUB_URL=$NEW_GH" >> "$CONF_FILE"
                    echo "CONFIG_SAVED:GITHUB_URL=$NEW_GH"
                else
                    echo "Usage: $0 config set-github <url>"
                fi
                ;;
            auto)
                CUR_GH=$(grep "^GITHUB_URL=" "$CONF_FILE" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]')
                [ -z "$CUR_GH" ] && CUR_GH="https://github.com/NightKnight24"
                cat <<EOF > "$CONF_FILE"
GATEWAY_IP=auto
GATEWAY_MAC=auto
BANDWIDTH_SENTINEL=enabled
BATTERY_SAVER=enabled
GITHUB_URL=$CUR_GH
EOF
                resolve_gateway
                echo "CONFIG_AUTO_RESET:IP=$ROUTER_IP:MAC=$ROUTER_MAC"
                ;;
            get|show|*)
                init_config
                CFG_IP=$(grep "^GATEWAY_IP=" "$CONF_FILE" 2>/dev/null | cut -d= -f2 | tr -d '[:space:]')
                CFG_MAC=$(grep "^GATEWAY_MAC=" "$CONF_FILE" 2>/dev/null | cut -d= -f2 | tr -d '[:space:]')
                CFG_GH=$(grep "^GITHUB_URL=" "$CONF_FILE" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]')
                echo "MODE=${CFG_IP:-auto}"
                echo "ROUTER_IP=$ROUTER_IP"
                echo "ROUTER_MAC=$ROUTER_MAC"
                echo "BANDWIDTH_SENTINEL=active"
                echo "GITHUB_URL=${CFG_GH:-https://github.com/NightKnight24}"
                ;;
        esac
        ;;

    status)
        if [ -f "$STATE_FILE" ]; then
            cat "$STATE_FILE"
        else
            echo "INACTIVE"
        fi
        ;;

    daemon)
        SUB="$2"
        case "$SUB" in
            status)
                if [ -f "$STATE_FILE" ]; then
                    echo "DAEMON_ACTIVE"
                else
                    echo "DAEMON_INACTIVE"
                fi
                ;;
            enable)
                D_MODE="${3:-streaming}"
                apply_optimizations "$D_MODE"
                mkdir -p /var/mobile/Library/Caches 2>/dev/null
                echo "ACTIVE:$D_MODE" > "$STATE_FILE"
                echo "DAEMON_ENABLED:$D_MODE"
                ;;
            disable)
                revert_optimizations
                rm -f "$STATE_FILE" 2>/dev/null
                echo "DAEMON_DISABLED"
                ;;
        esac
        ;;

    run|hud|interactive)
        RUN_MODE="${2:-streaming}"
        apply_optimizations "$RUN_MODE"
        trap 'revert_optimizations; echo -e "\n\033[1;32m[✔] Defaults restored.\033[0m"; exit 0' SIGHUP SIGINT SIGTERM EXIT
        export SHIELD_MODE_ENV="$RUN_MODE"
        export ROUTER_IP_ENV="$ROUTER_IP"
        export ROUTER_MAC_ENV="$ROUTER_MAC"
        
        PYTHON_EXEC="${JB}/usr/bin/python3"
        [ ! -x "$PYTHON_EXEC" ] && PYTHON_EXEC="python3"
        
        "$PYTHON_EXEC" - <<'PY_CLI_END'
import os, sys, time, subprocess

mode = os.environ.get("SHIELD_MODE_ENV", "streaming")
router_ip = os.environ.get("ROUTER_IP_ENV", "192.168.0.1")
router_mac = os.environ.get("ROUTER_MAC_ENV", "auto")

C_RESET = '\033[0m'
C_GREEN = '\033[0;32m'
C_BRIGHT_GREEN = '\033[1;32m'
C_YELLOW = '\033[1;33m'
C_RED = '\033[0;31m'
C_CYAN = '\033[1;36m'
C_MAGENTA = '\033[1;35m'
C_GRAY = '\033[0;37m'

mode_tag = "\033[1;32m🎮 GAMING (TSO:Off)\033[0m" if mode == "gaming" else "\033[1;35m🎬 STREAMING (Retina HD)\033[0m"

def get_bytes(iface="en0"):
    try:
        out = subprocess.check_output(['netstat', '-ib', '-I', iface], stderr=subprocess.DEVNULL).decode()
        for line in out.strip().splitlines()[1:]:
            p = line.split()
            if len(p) >= 10 and (p[0] == iface or p[0] == f"<{iface}>" or p[0].startswith(iface)):
                return int(p[6]), int(p[9])
    except:
        pass
    return 0, 0

def get_battery():
    try:
        out = subprocess.check_output(['ioreg', '-rc', 'AppleARMPMUCharger'], stderr=subprocess.DEVNULL).decode()
        for line in out.splitlines():
            if 'CurrentCapacity' in line and '=' in line:
                return line.split('=')[1].strip() + "%"
    except:
        pass
    return "100%"

def ping(host, t=350):
    try:
        out = subprocess.check_output(['ping', '-c', '1', '-W', str(t), host], stderr=subprocess.DEVNULL).decode()
        for l in out.splitlines():
            if 'time=' in l:
                return float(l.split('time=')[1].split()[0])
    except:
        pass
    return None

def fmt(b):
    if b >= 1048576: return f"{b/1048576:.1f} MB/s"
    if b >= 1024: return f"{b/1024:.1f} KB/s"
    return f"{b} B/s"

def col_ping(ms):
    if ms is None: return f"{C_RED}Timeout{C_RESET}"
    if ms < 4.0: return f"{C_GREEN}{ms:.1f}ms{C_RESET}"
    if ms < 15.0: return f"{C_YELLOW}{ms:.1f}ms{C_RESET}"
    return f"{C_RED}{ms:.1f}ms{C_RESET}"

print(f"{C_BRIGHT_GREEN}Anti-Lag Shield Pro Active [{mode_tag}] (Press Ctrl+C to stop)...{C_RESET}")
last_rx, last_tx = get_bytes()
last_time = time.time()

try:
    while True:
        time.sleep(1.0)
        now = time.time()
        dt = max(now - last_time, 0.1)
        rx, tx = get_bytes()
        down = fmt(max(0, (rx - last_rx) / dt))
        up = fmt(max(0, (tx - last_tx) / dt))
        last_rx, last_tx = rx, tx
        last_time = now

        r_ms = ping(router_ip, 250)
        i_ms = ping("1.1.1.1", 350)
        r_str = col_ping(r_ms)
        i_str = col_ping(i_ms)
        bat_str = get_battery()
        ts = time.strftime("%H:%M:%S")

        print(f"[{ts}] {mode_tag} | 📶 Wi-Fi | Router: {r_str} | Ping: {i_str} | 🔋 {bat_str} | ↓ {down} | ↑ {up}")
        sys.stdout.flush()
except KeyboardInterrupt:
    pass
PY_CLI_END
        ;;

    *)
        echo "Usage: $0 {start [mode]|stop|status|purge|clean|turbo [enable|disable|status]|stremio_status|config [show|set <ip> <mac>|auto]|run [mode]|daemon [enable|disable|status]}"
        exit 1
        ;;
esac
